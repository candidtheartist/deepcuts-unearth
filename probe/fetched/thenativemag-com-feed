	<item>
		<title>Interview: Blxckie Is Embracing Growth On ‘YENA’</title>
		<link>https://thenativemag.com/interview-blxckie-is-embracing-growth-on-yena/</link>
					<comments>https://thenativemag.com/interview-blxckie-is-embracing-growth-on-yena/#respond</comments>
		
		<dc:creator><![CDATA[The Native]]></dc:creator>
		<pubDate>Fri, 30 Oct 2026 09:38:36 +0000</pubDate>
